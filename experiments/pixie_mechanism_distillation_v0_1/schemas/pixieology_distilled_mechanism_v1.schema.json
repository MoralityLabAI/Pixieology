{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pixieology_distilled_mechanism_v1.schema.json",
  "type": "object",
  "required": ["schema", "task_family_id", "candidate", "codebook", "transition_table", "sparse_invariant", "description_length_bits", "discovery_evaluation", "selection", "program_sha256"],
  "properties": {
    "schema": {"const": "pixieology_distilled_mechanism_v1"},
    "codebook": {
      "type": "object",
      "required": ["method", "state_count", "dimensions", "centers"],
      "properties": {"state_count": {"type": "integer", "minimum": 1, "maximum": 8}}
    },
    "transition_table": {"type": "array", "minItems": 1},
    "description_length_bits": {"type": "number", "exclusiveMinimum": 0},
    "program_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
