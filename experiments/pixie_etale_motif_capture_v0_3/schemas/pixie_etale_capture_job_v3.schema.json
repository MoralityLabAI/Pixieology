{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pixie etale continuation capture job v3",
  "type": "object",
  "required": [
    "schema",
    "job_id",
    "status",
    "source_protocol_sha256",
    "source_corpus_sha256",
    "row_start",
    "row_count",
    "chunk_indices",
    "families",
    "checkpoint_rows",
    "expected_checkpoint_count",
    "splits",
    "loader_strategy",
    "caps",
    "gpu_guard",
    "authorization",
    "abort_is_valid_outcome",
    "claim_boundary"
  ],
  "properties": {
    "schema": { "const": "pixie_etale_capture_job_v3" },
    "job_id": { "const": "capture-pixie-etale-continuation-160-v0_3" },
    "status": { "const": "PROPOSED" },
    "source_protocol_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_corpus_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "row_start": { "const": 32 },
    "row_count": { "const": 160 },
    "chunk_indices": { "const": [1, 2, 3, 4, 5] },
    "families": {
      "const": [
        "pixie_style",
        "copy_induction",
        "format_following",
        "binary_fact",
        "one_step_arithmetic"
      ]
    },
    "checkpoint_rows": { "const": 8 },
    "expected_checkpoint_count": { "const": 20 },
    "splits": {
      "const": {
        "discovery": 80,
        "confirmation": 40,
        "transfer": 40
      }
    },
    "loader_strategy": { "const": "sequential_safetensors_materialization_v2" },
    "caps": { "type": "object" },
    "gpu_guard": { "type": "object" },
    "authorization": { "type": "object" },
    "abort_is_valid_outcome": { "const": true },
    "claim_boundary": { "type": "string" }
  },
  "additionalProperties": false
}
